{
 "doctype":"DocType", "name":"Delivery Order", "module":"Logistics", "autoname":"format:DO-{#####}",
 "field_order":["customer_name","customer_phone","address","cash_amount","priority","status","assigned_driver","delivery_run","created_date","delivered_date"],
 "fields":[
  {"fieldname":"customer_name","label":"Customer Name","fieldtype":"Data","reqd":1,"in_list_view":1},
  {"fieldname":"customer_phone","label":"Customer Phone","fieldtype":"Data"},
  {"fieldname":"address","label":"Address","fieldtype":"Small Text","reqd":1},
  {"fieldname":"cash_amount","label":"Cash Amount","fieldtype":"Currency","default":"0","reqd":1,"in_list_view":1},
  {"fieldname":"priority","label":"Priority","fieldtype":"Select","options":"High\nMedium\nLow","default":"Medium","in_list_view":1},
  {"fieldname":"status","label":"Status","fieldtype":"Select","options":"Open\nAssigned\nEn Route\nDelivered\nFailed\nCash Banked","default":"Open","read_only":1,"in_list_view":1},
  {"fieldname":"assigned_driver","label":"Assigned Driver","fieldtype":"Link","options":"Driver","read_only":1},
  {"fieldname":"delivery_run","label":"Delivery Run","fieldtype":"Link","options":"Delivery Run","read_only":1},
  {"fieldname":"created_date","label":"Created Date","fieldtype":"Datetime","default":"Now","read_only":1},
  {"fieldname":"delivered_date","label":"Delivered Date","fieldtype":"Datetime","read_only":1}
 ],
 "permissions":[
  {"role":"Logistics Manager","read":1,"write":1,"create":1,"delete":1,"report":1,"export":1},
  {"role":"Logistics Dispatcher","read":1,"write":1,"create":1,"report":1}
 ]
}
